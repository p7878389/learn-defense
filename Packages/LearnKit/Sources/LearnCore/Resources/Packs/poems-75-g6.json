{
  "schemaVersion": 1,
  "id": "poems-75-g6",
  "title": "小学生必背古诗词75首 · 六年级",
  "subject": "chinese",
  "grade": "g6",
  "edition": "小学生必背古诗词75首",
  "units": [
    {
      "id": "u1",
      "title": "第一单元 · 雨润江南（4首）",
      "theme": "meadow",
      "lessons": [
        {
          "id": "l1",
          "title": "春夜喜雨 · 早春呈水部张十八员外",
          "poems": [
            {
              "title": "春夜喜雨",
              "dynasty": "唐",
              "lines": [
                "好雨知时节",
                "当春乃发生",
                "随风潜入夜",
                "润物细无声",
                "野径云俱黑",
                "江船火独明",
                "晓看红湿处",
                "花重锦官城"
              ],
              "author": "杜甫"
            },
            {
              "title": "早春呈水部张十八员外",
              "dynasty": "唐",
              "lines": [
                "天街小雨润如酥",
                "草色遥看近却无",
                "最是一年春好处",
                "绝胜烟柳满皇都"
              ],
              "author": "韩愈"
            }
          ]
        },
        {
          "id": "l2",
          "title": "江南春 · 六月二十七日望湖楼醉书",
          "poems": [
            {
              "title": "江南春",
              "dynasty": "唐",
              "lines": [
                "千里莺啼绿映红",
                "水村山郭酒旗风",
                "南朝四百八十寺",
                "多少楼台烟雨中"
              ],
              "author": "杜牧"
            },
            {
              "title": "六月二十七日望湖楼醉书",
              "dynasty": "宋",
              "lines": [
                "黑云翻墨未遮山",
                "白雨跳珠乱入船",
                "卷地风来忽吹散",
                "望湖楼下水如天"
              ],
              "author": "苏轼"
            }
          ]
        }
      ]
    },
    {
      "id": "u2",
      "title": "第二单元 · 西湖与庭院（4首）",
      "theme": "orchard",
      "lessons": [
        {
          "id": "l1",
          "title": "晓出净慈寺送林子方 · 书湖阴先生壁",
          "poems": [
            {
              "title": "晓出净慈寺送林子方",
              "dynasty": "宋",
              "lines": [
                "毕竟西湖六月中",
                "风光不与四时同",
                "接天莲叶无穷碧",
                "映日荷花别样红"
              ],
              "author": "杨万里"
            },
            {
              "title": "书湖阴先生壁",
              "dynasty": "宋",
              "lines": [
                "茅檐长扫净无苔",
                "花木成畦手自栽",
                "一水护田将绿绕",
                "两山排闼送青来"
              ],
              "author": "王安石"
            }
          ]
        },
        {
          "id": "l2",
          "title": "泊船瓜洲 · 送元二使安西",
          "poems": [
            {
              "title": "泊船瓜洲",
              "dynasty": "宋",
              "lines": [
                "京口瓜洲一水间",
                "钟山只隔数重山",
                "春风又绿江南岸",
                "明月何时照我还"
              ],
              "author": "王安石"
            },
            {
              "title": "送元二使安西",
              "dynasty": "唐",
              "lines": [
                "渭城朝雨浥轻尘",
                "客舍青青柳色新",
                "劝君更尽一杯酒",
                "西出阳关无故人"
              ],
              "author": "王维"
            }
          ]
        }
      ]
    },
    {
      "id": "u3",
      "title": "第三单元 · 咏物言志与哲理（4首）",
      "theme": "academy",
      "lessons": [
        {
          "id": "l1",
          "title": "墨梅 · 石灰吟",
          "poems": [
            {
              "title": "墨梅",
              "dynasty": "元",
              "lines": [
                "我家洗砚池头树",
                "朵朵花开淡墨痕",
                "不要人夸好颜色",
                "只留清气满乾坤"
              ],
              "author": "王冕"
            },
            {
              "title": "石灰吟",
              "dynasty": "明",
              "lines": [
                "千锤万凿出深山",
                "烈火焚烧若等闲",
                "粉骨碎身浑不怕",
                "要留清白在人间"
              ],
              "author": "于谦"
            }
          ]
        },
        {
          "id": "l2",
          "title": "竹石 · 观书有感",
          "poems": [
            {
              "title": "竹石",
              "dynasty": "清",
              "lines": [
                "咬定青山不放松",
                "立根原在破岩中",
                "千磨万击还坚劲",
                "任尔东西南北风"
              ],
              "author": "郑燮"
            },
            {
              "title": "观书有感",
              "dynasty": "宋",
              "lines": [
                "半亩方塘一鉴开",
                "天光云影共徘徊",
                "问渠那得清如许",
                "为有源头活水来"
              ],
              "author": "朱熹"
            }
          ]
        }
      ]
    }
  ]
}
