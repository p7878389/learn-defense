{
  "schemaVersion": 1,
  "id": "poems-75-g5",
  "title": "小学生必背古诗词75首 · 五年级",
  "subject": "chinese",
  "grade": "g5",
  "edition": "小学生必背古诗词75首",
  "units": [
    {
      "id": "u1",
      "title": "第一单元 · 亲情与羁旅（5首）",
      "theme": "starry",
      "lessons": [
        {
          "id": "l1",
          "title": "游子吟 · 回乡偶书",
          "poems": [
            {
              "title": "游子吟",
              "dynasty": "唐",
              "lines": [
                "慈母手中线",
                "游子身上衣",
                "临行密密缝",
                "意恐迟迟归",
                "谁言寸草心",
                "报得三春晖"
              ],
              "author": "孟郊"
            },
            {
              "title": "回乡偶书",
              "dynasty": "唐",
              "lines": [
                "少小离家老大回",
                "乡音无改鬓毛衰",
                "儿童相见不相识",
                "笑问客从何处来"
              ],
              "author": "贺知章"
            }
          ]
        },
        {
          "id": "l2",
          "title": "枫桥夜泊 · 黄鹤楼送孟浩然之广陵 · 凉州词",
          "poems": [
            {
              "title": "枫桥夜泊",
              "dynasty": "唐",
              "lines": [
                "月落乌啼霜满天",
                "江枫渔火对愁眠",
                "姑苏城外寒山寺",
                "夜半钟声到客船"
              ],
              "author": "张继"
            },
            {
              "title": "黄鹤楼送孟浩然之广陵",
              "dynasty": "唐",
              "lines": [
                "故人西辞黄鹤楼",
                "烟花三月下扬州",
                "孤帆远影碧空尽",
                "唯见长江天际流"
              ],
              "author": "李白"
            },
            {
              "title": "凉州词（王之涣）",
              "dynasty": "唐",
              "lines": [
                "黄河远上白云间",
                "一片孤城万仞山",
                "羌笛何须怨杨柳",
                "春风不度玉门关"
              ],
              "author": "王之涣"
            }
          ]
        }
      ]
    },
    {
      "id": "u2",
      "title": "第二单元 · 山水与惜时（4首）",
      "theme": "meadow",
      "lessons": [
        {
          "id": "l1",
          "title": "渔歌子 · 江上渔者",
          "poems": [
            {
              "title": "渔歌子",
              "dynasty": "唐",
              "lines": [
                "西塞山前白鹭飞",
                "桃花流水鳜鱼肥",
                "青箬笠",
                "绿蓑衣",
                "斜风细雨不须归"
              ],
              "author": "张志和"
            },
            {
              "title": "江上渔者",
              "dynasty": "宋",
              "lines": [
                "江上往来人",
                "但爱鲈鱼美",
                "君看一叶舟",
                "出没风波里"
              ],
              "author": "范仲淹"
            }
          ]
        },
        {
          "id": "l2",
          "title": "长歌行 · 游园不值",
          "poems": [
            {
              "title": "长歌行",
              "dynasty": "汉",
              "lines": [
                "青青园中葵",
                "朝露待日晞",
                "阳春布德泽",
                "万物生光辉",
                "常恐秋节至",
                "焜黄华叶衰",
                "百川东到海",
                "何时复西归",
                "少壮不努力",
                "老大徒伤悲"
              ],
              "author": "汉乐府"
            },
            {
              "title": "游园不值",
              "dynasty": "宋",
              "lines": [
                "应怜屐齿印苍苔",
                "小扣柴扉久不开",
                "春色满园关不住",
                "一枝红杏出墙来"
              ],
              "author": "叶绍翁"
            }
          ]
        }
      ]
    },
    {
      "id": "u3",
      "title": "第三单元 · 家国赤子心（4首）",
      "theme": "academy",
      "lessons": [
        {
          "id": "l1",
          "title": "示儿 · 秋夜将晓出篱门迎凉有感",
          "poems": [
            {
              "title": "示儿",
              "dynasty": "宋",
              "lines": [
                "死去元知万事空",
                "但悲不见九州同",
                "王师北定中原日",
                "家祭无忘告乃翁"
              ],
              "author": "陆游"
            },
            {
              "title": "秋夜将晓出篱门迎凉有感",
              "dynasty": "宋",
              "lines": [
                "三万里河东入海",
                "五千仞岳上摩天",
                "遗民泪尽胡尘里",
                "南望王师又一年"
              ],
              "author": "陆游"
            }
          ]
        },
        {
          "id": "l2",
          "title": "题临安邸 · 己亥杂诗",
          "poems": [
            {
              "title": "题临安邸",
              "dynasty": "宋",
              "lines": [
                "山外青山楼外楼",
                "西湖歌舞几时休",
                "暖风熏得游人醉",
                "直把杭州作汴州"
              ],
              "author": "林升"
            },
            {
              "title": "己亥杂诗",
              "dynasty": "清",
              "lines": [
                "九州生气恃风雷",
                "万马齐喑究可哀",
                "我劝天公重抖擞",
                "不拘一格降人才"
              ],
              "author": "龚自珍"
            }
          ]
        }
      ]
    }
  ]
}
