{
  "schemaVersion": 1,
  "id": "poems-75-g2",
  "title": "小学生必背古诗词75首 · 二年级",
  "subject": "chinese",
  "grade": "g2",
  "edition": "小学生必背古诗词75首",
  "units": [
    {
      "id": "u1",
      "title": "第一单元 · 春风与原野（4首）",
      "theme": "meadow",
      "lessons": [
        {
          "id": "l1",
          "title": "村居 · 咏柳",
          "poems": [
            {
              "title": "村居",
              "dynasty": "清",
              "lines": [
                "草长莺飞二月天",
                "拂堤杨柳醉春烟",
                "儿童散学归来早",
                "忙趁东风放纸鸢"
              ],
              "author": "高鼎"
            },
            {
              "title": "咏柳",
              "dynasty": "唐",
              "lines": [
                "碧玉妆成一树高",
                "万条垂下绿丝绦",
                "不知细叶谁裁出",
                "二月春风似剪刀"
              ],
              "author": "贺知章"
            }
          ]
        },
        {
          "id": "l2",
          "title": "赋得古原草送别 · 敕勒歌",
          "poems": [
            {
              "title": "赋得古原草送别",
              "dynasty": "唐",
              "lines": [
                "离离原上草",
                "一岁一枯荣",
                "野火烧不尽",
                "春风吹又生",
                "远芳侵古道",
                "晴翠接荒城",
                "又送王孙去",
                "萋萋满别情"
              ],
              "author": "白居易"
            },
            {
              "title": "敕勒歌",
              "dynasty": "北朝",
              "lines": [
                "敕勒川",
                "阴山下",
                "天似穹庐",
                "笼盖四野",
                "天苍苍",
                "野茫茫",
                "风吹草低见牛羊"
              ],
              "author": "北朝民歌"
            }
          ]
        }
      ]
    },
    {
      "id": "u2",
      "title": "第二单元 · 壮丽山河（4首）",
      "theme": "starry",
      "lessons": [
        {
          "id": "l1",
          "title": "登鹳雀楼 · 望庐山瀑布",
          "poems": [
            {
              "title": "登鹳雀楼",
              "dynasty": "唐",
              "lines": [
                "白日依山尽",
                "黄河入海流",
                "欲穷千里目",
                "更上一层楼"
              ],
              "author": "王之涣"
            },
            {
              "title": "望庐山瀑布",
              "dynasty": "唐",
              "lines": [
                "日照香炉生紫烟",
                "遥看瀑布挂前川",
                "飞流直下三千尺",
                "疑是银河落九天"
              ],
              "author": "李白"
            }
          ]
        },
        {
          "id": "l2",
          "title": "江雪 · 早发白帝城",
          "poems": [
            {
              "title": "江雪",
              "dynasty": "唐",
              "lines": [
                "千山鸟飞绝",
                "万径人踪灭",
                "孤舟蓑笠翁",
                "独钓寒江雪"
              ],
              "author": "柳宗元"
            },
            {
              "title": "早发白帝城",
              "dynasty": "唐",
              "lines": [
                "朝辞白帝彩云间",
                "千里江陵一日还",
                "两岸猿声啼不住",
                "轻舟已过万重山"
              ],
              "author": "李白"
            }
          ]
        }
      ]
    },
    {
      "id": "u3",
      "title": "第三单元 · 春景与真情（4首）",
      "theme": "orchard",
      "lessons": [
        {
          "id": "l1",
          "title": "杜甫绝句二首",
          "poems": [
            {
              "title": "绝句（两个黄鹂）",
              "dynasty": "唐",
              "lines": [
                "两个黄鹂鸣翠柳",
                "一行白鹭上青天",
                "窗含西岭千秋雪",
                "门泊东吴万里船"
              ],
              "author": "杜甫"
            },
            {
              "title": "绝句（迟日江山丽）",
              "dynasty": "唐",
              "lines": [
                "迟日江山丽",
                "春风花草香",
                "泥融飞燕子",
                "沙暖睡鸳鸯"
              ],
              "author": "杜甫"
            }
          ]
        },
        {
          "id": "l2",
          "title": "赠汪伦 · 小儿垂钓",
          "poems": [
            {
              "title": "赠汪伦",
              "dynasty": "唐",
              "lines": [
                "李白乘舟将欲行",
                "忽闻岸上踏歌声",
                "桃花潭水深千尺",
                "不及汪伦送我情"
              ],
              "author": "李白"
            },
            {
              "title": "小儿垂钓",
              "dynasty": "唐",
              "lines": [
                "蓬头稚子学垂纶",
                "侧坐莓苔草映身",
                "路人借问遥招手",
                "怕得鱼惊不应人"
              ],
              "author": "胡令能"
            }
          ]
        }
      ]
    }
  ]
}
