{
  "schemaVersion": 1,
  "id": "poems-75-g3",
  "title": "小学生必背古诗词75首 · 三年级",
  "subject": "chinese",
  "grade": "g3",
  "edition": "小学生必背古诗词75首",
  "units": [
    {
      "id": "u1",
      "title": "第一单元 · 山水与秋色（4首）",
      "theme": "orchard",
      "lessons": [
        {
          "id": "l1",
          "title": "山行 · 望洞庭",
          "poems": [
            {
              "title": "山行",
              "dynasty": "唐",
              "lines": [
                "远上寒山石径斜",
                "白云生处有人家",
                "停车坐爱枫林晚",
                "霜叶红于二月花"
              ],
              "author": "杜牧"
            },
            {
              "title": "望洞庭",
              "dynasty": "唐",
              "lines": [
                "湖光秋月两相和",
                "潭面无风镜未磨",
                "遥望洞庭山水翠",
                "白银盘里一青螺"
              ],
              "author": "刘禹锡"
            }
          ]
        },
        {
          "id": "l2",
          "title": "望天门山 · 鹿柴",
          "poems": [
            {
              "title": "望天门山",
              "dynasty": "唐",
              "lines": [
                "天门中断楚江开",
                "碧水东流至此回",
                "两岸青山相对出",
                "孤帆一片日边来"
              ],
              "author": "李白"
            },
            {
              "title": "鹿柴",
              "dynasty": "唐",
              "lines": [
                "空山不见人",
                "但闻人语响",
                "返景入深林",
                "复照青苔上"
              ],
              "author": "王维"
            }
          ]
        }
      ]
    },
    {
      "id": "u2",
      "title": "第二单元 · 江南春景（5首）",
      "theme": "meadow",
      "lessons": [
        {
          "id": "l1",
          "title": "饮湖上初晴后雨 · 惠崇春江晚景",
          "poems": [
            {
              "title": "饮湖上初晴后雨",
              "dynasty": "宋",
              "lines": [
                "水光潋滟晴方好",
                "山色空蒙雨亦奇",
                "欲把西湖比西子",
                "淡妆浓抹总相宜"
              ],
              "author": "苏轼"
            },
            {
              "title": "惠崇春江晚景",
              "dynasty": "宋",
              "lines": [
                "竹外桃花三两枝",
                "春江水暖鸭先知",
                "蒌蒿满地芦芽短",
                "正是河豚欲上时"
              ],
              "author": "苏轼"
            }
          ]
        },
        {
          "id": "l2",
          "title": "忆江南 · 三衢道中 · 春日",
          "poems": [
            {
              "title": "忆江南",
              "dynasty": "唐",
              "lines": [
                "江南好",
                "风景旧曾谙",
                "日出江花红胜火",
                "春来江水绿如蓝",
                "能不忆江南"
              ],
              "author": "白居易"
            },
            {
              "title": "三衢道中",
              "dynasty": "宋",
              "lines": [
                "梅子黄时日日晴",
                "小溪泛尽却山行",
                "绿阴不减来时路",
                "添得黄鹂四五声"
              ],
              "author": "曾几"
            },
            {
              "title": "春日",
              "dynasty": "宋",
              "lines": [
                "胜日寻芳泗水滨",
                "无边光景一时新",
                "等闲识得东风面",
                "万紫千红总是春"
              ],
              "author": "朱熹"
            }
          ]
        }
      ]
    },
    {
      "id": "u3",
      "title": "第三单元 · 传统佳节与幽景（4首）",
      "theme": "academy",
      "lessons": [
        {
          "id": "l1",
          "title": "元日 · 清明",
          "poems": [
            {
              "title": "元日",
              "dynasty": "宋",
              "lines": [
                "爆竹声中一岁除",
                "春风送暖入屠苏",
                "千门万户曈曈日",
                "总把新桃换旧符"
              ],
              "author": "王安石"
            },
            {
              "title": "清明",
              "dynasty": "唐",
              "lines": [
                "清明时节雨纷纷",
                "路上行人欲断魂",
                "借问酒家何处有",
                "牧童遥指杏花村"
              ],
              "author": "杜牧"
            }
          ]
        },
        {
          "id": "l2",
          "title": "九月九日忆山东兄弟 · 滁州西涧",
          "poems": [
            {
              "title": "九月九日忆山东兄弟",
              "dynasty": "唐",
              "lines": [
                "独在异乡为异客",
                "每逢佳节倍思亲",
                "遥知兄弟登高处",
                "遍插茱萸少一人"
              ],
              "author": "王维"
            },
            {
              "title": "滁州西涧",
              "dynasty": "唐",
              "lines": [
                "独怜幽草涧边生",
                "上有黄鹂深树鸣",
                "春潮带雨晚来急",
                "野渡无人舟自横"
              ],
              "author": "韦应物"
            }
          ]
        }
      ]
    }
  ]
}
