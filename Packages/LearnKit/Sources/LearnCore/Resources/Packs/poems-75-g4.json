{
  "schemaVersion": 1,
  "id": "poems-75-g4",
  "title": "小学生必背古诗词75首 · 四年级",
  "subject": "chinese",
  "grade": "g4",
  "edition": "小学生必背古诗词75首",
  "units": [
    {
      "id": "u1",
      "title": "第一单元 · 田园四时（5首）",
      "theme": "orchard",
      "lessons": [
        {
          "id": "l1",
          "title": "四时田园杂兴二首",
          "poems": [
            {
              "title": "四时田园杂兴（其二十五）",
              "dynasty": "宋",
              "lines": [
                "梅子金黄杏子肥",
                "麦花雪白菜花稀",
                "日长篱落无人过",
                "惟有蜻蜓蛱蝶飞"
              ],
              "author": "范成大"
            },
            {
              "title": "四时田园杂兴（其三十一）",
              "dynasty": "宋",
              "lines": [
                "昼出耘田夜绩麻",
                "村庄儿女各当家",
                "童孙未解供耕织",
                "也傍桑阴学种瓜"
              ],
              "author": "范成大"
            }
          ]
        },
        {
          "id": "l2",
          "title": "乡村四月 · 江畔独步寻花 · 蜂",
          "poems": [
            {
              "title": "乡村四月",
              "dynasty": "宋",
              "lines": [
                "绿遍山原白满川",
                "子规声里雨如烟",
                "乡村四月闲人少",
                "才了蚕桑又插田"
              ],
              "author": "翁卷"
            },
            {
              "title": "江畔独步寻花",
              "dynasty": "唐",
              "lines": [
                "黄师塔前江水东",
                "春光懒困倚微风",
                "桃花一簇开无主",
                "可爱深红爱浅红"
              ],
              "author": "杜甫"
            },
            {
              "title": "蜂",
              "dynasty": "唐",
              "lines": [
                "不论平地与山尖",
                "无限风光尽被占",
                "采得百花成蜜后",
                "为谁辛苦为谁甜"
              ],
              "author": "罗隐"
            }
          ]
        }
      ]
    },
    {
      "id": "u2",
      "title": "第二单元 · 边塞豪情（4首）",
      "theme": "starry",
      "lessons": [
        {
          "id": "l1",
          "title": "出塞 · 凉州词（王翰）",
          "poems": [
            {
              "title": "出塞",
              "dynasty": "唐",
              "lines": [
                "秦时明月汉时关",
                "万里长征人未还",
                "但使龙城飞将在",
                "不教胡马度阴山"
              ],
              "author": "王昌龄"
            },
            {
              "title": "凉州词（王翰）",
              "dynasty": "唐",
              "lines": [
                "葡萄美酒夜光杯",
                "欲饮琵琶马上催",
                "醉卧沙场君莫笑",
                "古来征战几人回"
              ],
              "author": "王翰"
            }
          ]
        },
        {
          "id": "l2",
          "title": "塞下曲 · 夏日绝句",
          "poems": [
            {
              "title": "塞下曲",
              "dynasty": "唐",
              "lines": [
                "月黑雁飞高",
                "单于夜遁逃",
                "欲将轻骑逐",
                "大雪满弓刀"
              ],
              "author": "卢纶"
            },
            {
              "title": "夏日绝句",
              "dynasty": "宋",
              "lines": [
                "生当作人杰",
                "死亦为鬼雄",
                "至今思项羽",
                "不肯过江东"
              ],
              "author": "李清照"
            }
          ]
        }
      ]
    },
    {
      "id": "u3",
      "title": "第三单元 · 哲思与送别（4首）",
      "theme": "academy",
      "lessons": [
        {
          "id": "l1",
          "title": "题西林壁 · 浪淘沙",
          "poems": [
            {
              "title": "题西林壁",
              "dynasty": "宋",
              "lines": [
                "横看成岭侧成峰",
                "远近高低各不同",
                "不识庐山真面目",
                "只缘身在此山中"
              ],
              "author": "苏轼"
            },
            {
              "title": "浪淘沙",
              "dynasty": "唐",
              "lines": [
                "九曲黄河万里沙",
                "浪淘风簸自天涯",
                "如今直上银河去",
                "同到牵牛织女家"
              ],
              "author": "刘禹锡"
            }
          ]
        },
        {
          "id": "l2",
          "title": "芙蓉楼送辛渐 · 别董大",
          "poems": [
            {
              "title": "芙蓉楼送辛渐",
              "dynasty": "唐",
              "lines": [
                "寒雨连江夜入吴",
                "平明送客楚山孤",
                "洛阳亲友如相问",
                "一片冰心在玉壶"
              ],
              "author": "王昌龄"
            },
            {
              "title": "别董大",
              "dynasty": "唐",
              "lines": [
                "千里黄云白日曛",
                "北风吹雁雪纷纷",
                "莫愁前路无知己",
                "天下谁人不识君"
              ],
              "author": "高适"
            }
          ]
        }
      ]
    }
  ]
}
