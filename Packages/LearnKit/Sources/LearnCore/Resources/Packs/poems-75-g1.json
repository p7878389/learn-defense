{
  "schemaVersion": 1,
  "id": "poems-75-g1",
  "title": "小学生必背古诗词75首 · 一年级",
  "subject": "chinese",
  "grade": "g1",
  "edition": "小学生必背古诗词75首",
  "units": [
    {
      "id": "u1",
      "title": "第一单元 · 自然与生灵（4首）",
      "theme": "meadow",
      "lessons": [
        {
          "id": "l1",
          "title": "江南 · 咏鹅",
          "poems": [
            {
              "title": "江南",
              "dynasty": "汉",
              "lines": [
                "江南可采莲",
                "莲叶何田田",
                "鱼戏莲叶间",
                "鱼戏莲叶东",
                "鱼戏莲叶西",
                "鱼戏莲叶南",
                "鱼戏莲叶北"
              ],
              "author": "汉乐府"
            },
            {
              "title": "咏鹅",
              "dynasty": "唐",
              "lines": [
                "鹅鹅鹅",
                "曲项向天歌",
                "白毛浮绿水",
                "红掌拨清波"
              ],
              "author": "骆宾王"
            }
          ]
        },
        {
          "id": "l2",
          "title": "风 · 春晓",
          "poems": [
            {
              "title": "风",
              "dynasty": "唐",
              "lines": [
                "解落三秋叶",
                "能开二月花",
                "过江千尺浪",
                "入竹万竿斜"
              ],
              "author": "李峤"
            },
            {
              "title": "春晓",
              "dynasty": "唐",
              "lines": [
                "春眠不觉晓",
                "处处闻啼鸟",
                "夜来风雨声",
                "花落知多少"
              ],
              "author": "孟浩然"
            }
          ]
        }
      ]
    },
    {
      "id": "u2",
      "title": "第二单元 · 明月与勤劳（4首）",
      "theme": "starry",
      "lessons": [
        {
          "id": "l1",
          "title": "静夜思 · 古朗月行",
          "poems": [
            {
              "title": "静夜思",
              "dynasty": "唐",
              "lines": [
                "床前明月光",
                "疑是地上霜",
                "举头望明月",
                "低头思故乡"
              ],
              "author": "李白"
            },
            {
              "title": "古朗月行（节选）",
              "dynasty": "唐",
              "lines": [
                "小时不识月",
                "呼作白玉盘",
                "又疑瑶台镜",
                "飞在青云端",
                "仙人垂两足",
                "桂树何团团",
                "白兔捣药成",
                "问言与谁餐"
              ],
              "author": "李白"
            }
          ]
        },
        {
          "id": "l2",
          "title": "悯农二首",
          "poems": [
            {
              "title": "悯农（其一）",
              "dynasty": "唐",
              "lines": [
                "春种一粒粟",
                "秋收万颗子",
                "四海无闲田",
                "农夫犹饿死"
              ],
              "author": "李绅"
            },
            {
              "title": "悯农（其二）",
              "dynasty": "唐",
              "lines": [
                "锄禾日当午",
                "汗滴禾下土",
                "谁知盘中餐",
                "粒粒皆辛苦"
              ],
              "author": "李绅"
            }
          ]
        }
      ]
    },
    {
      "id": "u3",
      "title": "第三单元 · 寻访与童趣（4首）",
      "theme": "orchard",
      "lessons": [
        {
          "id": "l1",
          "title": "寻隐者不遇 · 池上",
          "poems": [
            {
              "title": "寻隐者不遇",
              "dynasty": "唐",
              "lines": [
                "松下问童子",
                "言师采药去",
                "只在此山中",
                "云深不知处"
              ],
              "author": "贾岛"
            },
            {
              "title": "池上",
              "dynasty": "唐",
              "lines": [
                "小娃撑小艇",
                "偷采白莲回",
                "不解藏踪迹",
                "浮萍一道开"
              ],
              "author": "白居易"
            }
          ]
        },
        {
          "id": "l2",
          "title": "小池 · 所见",
          "poems": [
            {
              "title": "小池",
              "dynasty": "宋",
              "lines": [
                "泉眼无声惜细流",
                "树阴照水爱晴柔",
                "小荷才露尖尖角",
                "早有蜻蜓立上头"
              ],
              "author": "杨万里"
            },
            {
              "title": "所见",
              "dynasty": "清",
              "lines": [
                "牧童骑黄牛",
                "歌声振林樾",
                "意欲捕鸣蝉",
                "忽然闭口立"
              ],
              "author": "袁枚"
            }
          ]
        }
      ]
    }
  ]
}
